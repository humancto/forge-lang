// RFC 4180 CSV parsing by hand: quoted fields may hold commas, quotes and
// line breaks, and values keep their exact text (leading zeros, spaces).

fn parse_csv(text: String) -> [[String]] {
    let chars = split(text, "")
    let n = len(chars)
    let mut records = []
    let mut record = []
    let mut field = ""
    let mut quoted = false
    let mut i = 0
    while i < n {
        let c = chars[i]
        if quoted {
            if c == "\"" {
                if i + 1 < n && chars[i + 1] == "\"" {
                    field += "\""
                    i += 1
                } else {
                    quoted = false
                }
            } else {
                field += c
            }
        } else if c == "\"" {
            quoted = true
        } else if c == "," {
            record.push(field)
            field = ""
        } else if c == "\r" && i + 1 < n && chars[i + 1] == "\n" {
            // the \n ends the record on the next iteration
        } else if c == "\n" {
            record.push(field)
            records.push(record)
            record = []
            field = ""
        } else {
            field += c
        }
        i += 1
    }
    if field != "" || len(record) > 0 {
        record.push(field)
        records.push(record)
    }
    return records
}

fn to_cents(amount: String) -> Int {
    if amount == "" {
        return 0
    }
    let parts = split(replace(amount, ",", ""), ".")
    let mut frac = 0
    if len(parts) > 1 {
        frac = int(pad_end(parts[1], 2, "0"))
    }
    return int(parts[0]) * 100 + frac
}

fn money(c: Int) -> String {
    return "{c / 100}.{pad_start(str(c % 100), 2, "0")}"
}

let rows = parse_csv(fs.read("/dev/stdin"))
let header = rows[0]
let records = map(slice(rows, 1, len(rows)), fn(r) {
    let mut rec = {}
    for e in enumerate(header) {
        rec[e.value] = r[e.index]
    }
    return rec
})

let by_id = sort(records, fn(a, b) {
    if a.id < b.id {
        return -1
    }
    if a.id > b.id {
        return 1
    }
    return 0
})

let mut totals = {}
for r in by_id {
    let c = to_cents(r.amount)
    totals[r.city] = get(totals, r.city, 0) + c
    let notes = replace(replace(r.notes, "\r\n", "\n"), "\n", "\\n")
    println("{r.id}|{r.name}|{r.city}|{money(c)}|{notes}")
}
println("--")
let cities = sort(keys(totals), fn(a, b) {
    if totals[a] != totals[b] {
        return totals[b] - totals[a]
    }
    if a < b {
        return -1
    }
    return 1
})
for city in cities {
    println("{city}: {money(totals[city])}")
}
