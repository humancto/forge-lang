// Business-day arithmetic on day numbers (days since 1970-01-01, a Thursday).

fn day_number(d: String) -> Int {
    return time.parse(d).unix / 86400
}

fn date_of(day: Int) -> String {
    return time.format(day * 86400, "%Y-%m-%d")
}

let lines = filter(fs.lines("/dev/stdin"), fn(l) { return l.trim() != "" })
let mut holidays = {}
for d in split(split(lines[0], ":")[1], ",") {
    holidays[str(day_number(d.trim()))] = true
}

fn is_business(day: Int) -> Bool {
    let weekday = (day + 3) % 7      // 0 = Monday ... 6 = Sunday
    return weekday < 5 && !has_key(holidays, str(day))
}

fn between(a: Int, b: Int) -> Int {
    if b < a {
        return -between(b, a)
    }
    let mut n = 0
    for day in range(a, b) {
        if is_business(day) {
            n += 1
        }
    }
    return n
}

fn add_days(start: Int, n: Int) -> Int {
    let mut day = start
    let mut count = 0
    while count < n {
        day += 1
        if is_business(day) {
            count += 1
        }
    }
    return day
}

for q in slice(lines, 1, len(lines)) {
    let p = split(q.trim(), " ")
    if p[0] == "between" {
        println("{q.trim()}: {between(day_number(p[1]), day_number(p[2]))}")
    } else {
        println("{q.trim()}: {date_of(add_days(day_number(p[1]), int(p[2])))}")
    }
}
