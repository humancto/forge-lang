// Latest-record-wins deduplication in O(n log n): sort the updates by
// (user, timestamp, input position), then take the last update of each run.

let lines = filter(fs.lines("/dev/stdin"), fn(l) { return l.trim() != "" })
let records = map(enumerate(lines), fn(e) {
    let p = split(e.value.trim(), " ")
    return { user: p[1], ts: int(p[0]), idx: e.index, plan: p[2] }
})

let ordered = sort(records, fn(a, b) {
    if a.user != b.user {
        if a.user < b.user {
            return -1
        }
        return 1
    }
    if a.ts != b.ts {
        return a.ts - b.ts
    }
    return a.idx - b.idx
})

// The last index of every run of equal users is that user's winning update.
let n = len(ordered)
let mut ends = []
for i in range(0, n) {
    if i == n - 1 || ordered[i + 1].user != ordered[i].user {
        ends.push(i)
    }
}
let users = map(enumerate(ends), fn(e) {
    let mut start = 0
    if e.index > 0 {
        start = ends[e.index - 1] + 1
    }
    let last = ordered[e.value]
    return { user: last.user, count: e.value - start + 1, plan: last.plan }
})

println("users: {len(users)}")
let per_plan = frequencies(map(users, fn(u) { return u.plan }))
for plan in sort(keys(per_plan)) {
    println("{plan}: {per_plan[plan]}")
}
println("most updates:")
// users is sorted by id and sort is stable, so ties stay in id order
let busiest = sort(users, fn(a, b) { return b.count - a.count })
for u in slice(busiest, 0, 5) {
    println("{u.user} {u.count} {u.plan}")
}
