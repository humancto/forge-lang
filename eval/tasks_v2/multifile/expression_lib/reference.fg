import { parse } from "lib/parser.fg"

fn evaluate(node, env) {
    if node.kind == "num" {
        return Ok(node.value)
    }
    if node.kind == "var" {
        if !has_key(env, node.name) {
            return Err("unknown variable: {node.name}")
        }
        return Ok(env[node.name])
    }
    if node.kind == "neg" {
        let v = evaluate(node.expr, env)?
        return Ok(-v)
    }
    let a = evaluate(node.left, env)?
    let b = evaluate(node.right, env)?
    if node.op == "+" {
        return Ok(a + b)
    }
    if node.op == "-" {
        return Ok(a - b)
    }
    if node.op == "*" {
        return Ok(a * b)
    }
    if b == 0 {
        return Err("division by zero")
    }
    if node.op == "/" {
        return Ok(a / b)        // Int / Int truncates toward zero
    }
    return Ok(a % b)            // remainder has the sign of a
}

fn run(src: String, env) {
    let tree = parse(src)?
    return evaluate(tree, env)
}

let mut env = {}
for raw in fs.lines("/dev/stdin") {
    let line = raw.trim()
    if line == "" {
        continue
    }
    if starts_with(line, "let ") {
        let rest = substring(line, 4, len(line))
        let eq = index_of(rest, "=")
        let name = substring(rest, 0, eq).trim()
        if !regex.test(name, "^[a-z_][a-z_0-9]*$") {
            println("error: bad name")
            continue
        }
        match run(substring(rest, eq + 1, len(rest)).trim(), env) {
            Ok(v) => {
                env[name] = v
                println("{name} = {v}")
            },
            Err(msg) => println("error: {msg}"),
        }
    } else {
        match run(line, env) {
            Ok(v) => println(v),
            Err(msg) => println("error: {msg}"),
        }
    }
}
