// lib/tokenizer.fg: split an arithmetic expression into tokens.
// Tokens are objects {kind, text} with kind "num", "name" or "op".

fn tokenize(src: String) {
    let chars = split(src, "")
    let mut tokens = []
    let mut i = 0
    while i < len(chars) {
        let c = chars[i]
        if c == " " {
            i += 1
        } else if regex.test(c, "^[0-9]$") {
            let mut text = ""
            while i < len(chars) && regex.test(chars[i], "^[0-9]$") {
                text += chars[i]
                i += 1
            }
            tokens.push({ kind: "num", text: text })
        } else if regex.test(c, "^[a-z_]$") {
            let mut text = ""
            while i < len(chars) && regex.test(chars[i], "^[a-z_0-9]$") {
                text += chars[i]
                i += 1
            }
            tokens.push({ kind: "name", text: text })
        } else if contains("+-*/%()", c) {
            tokens.push({ kind: "op", text: c })
            i += 1
        } else {
            return Err("unexpected character '{c}' at {i + 1}")
        }
    }
    return Ok(tokens)
}
