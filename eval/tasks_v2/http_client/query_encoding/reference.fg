// Let the client encode the query: pass the parameters as `params`.

let lines = filter(fs.lines("/dev/stdin"), fn(l) { return l.trim() != "" })
let base = lines[0].trim()
let mut params = {}
for line in slice(lines, 1, len(lines)) {
    let text = line.trim()
    let at = index_of(text, "=")
    params[substring(text, 0, at)] = substring(text, at + 1, len(text))
}

let got = http.get("{base}/echo", { params: params }).json.query
for name in sort(keys(got)) {
    println("{name} -> [{got[name]}]")
}
let same = len(keys(got)) == len(keys(params)) && all(keys(params), fn(k) {
    return has_key(got, k) && got[k] == params[k]
})
if same {
    println("round trip: ok")
} else {
    println("round trip: mismatch")
}
