// Retry each call (a `retry` block) with a per-attempt time limit (a
// `timeout` block). An attempt is simulated: `x` fails at once, a number of
// milliseconds sleeps that long and then succeeds.

fn attempt(spec: String) -> String {
    if spec == "x" {
        return "error"
    }
    let secs = int(spec) / 1000.0
    try {
        timeout 150 ms {
            wait(secs)
        }
    } catch e {
        return "timeout"
    }
    return "ok"
}

for line in fs.lines("/dev/stdin") {
    let f = split(line.trim(), " ")
    if len(f) != 3 {
        continue
    }
    let name = f[0]
    let specs = split(f[1], ",")
    let mut outcomes = []
    try {
        retry int(f[2]) times {
            let outcome = attempt(specs[len(outcomes)])
            outcomes.push(outcome)
            assert(outcome == "ok", outcome)
        }
        println("{name}: ok after {len(outcomes)} attempts ({join(outcomes, ", ")})")
    } catch e {
        println("{name}: gave up after {len(outcomes)} attempts ({join(outcomes, ", ")})")
    }
}
