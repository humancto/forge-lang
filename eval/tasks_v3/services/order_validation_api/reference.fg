@server(port: 18526)

// Collects every validation error of a nested order body, with paths.
db.open("orders.db")
db.execute("CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer TEXT, items INTEGER, total INTEGER)")

fn is_number(v) -> Bool {
    return typeof(v) == "Int" || typeof(v) == "Float"
}

fn validate(b) -> [String] {
    if typeof(b) != "Object" {
        return ["body must be an object"]
    }
    let mut errors = []
    let c = get(b, "customer", null)
    if typeof(c) != "Object" {
        errors.push("customer must be an object")
    } else {
        let name = get(c, "name", null)
        if typeof(name) != "String" || name.trim() == "" {
            errors.push("customer.name is required")
        }
        let email = get(c, "email", null)
        if typeof(email) != "String" || !regex.test(email, "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$") {
            errors.push("customer.email is invalid")
        }
    }
    let items = get(b, "items", null)
    if typeof(items) != "Array" || len(items) == 0 {
        errors.push("items must be a non-empty array")
    } else {
        for e in enumerate(items) {
            let i = e.index
            let it = e.value
            if typeof(it) != "Object" {
                errors.push("items[{i}] must be an object")
                continue
            }
            let sku = get(it, "sku", null)
            if typeof(sku) != "String" || !regex.test(sku, "^[A-Z]{3}-[0-9]{2}$") {
                errors.push("items[{i}].sku is invalid")
            }
            let qty = get(it, "qty", null)
            if typeof(qty) != "Int" || qty < 1 || qty > 99 {
                errors.push("items[{i}].qty must be an integer from 1 to 99")
            }
            let price = get(it, "price", null)
            if !is_number(price) || price <= 0 {
                errors.push("items[{i}].price must be a positive number")
            }
        }
    }
    if has_key(b, "coupon") && typeof(b.coupon) != "String" {
        errors.push("coupon must be a string")
    }
    return errors
}

@post("/orders")
fn create(body) {
    let errors = validate(body)
    if len(errors) > 0 {
        return http.response(422, { errors: errors })
    }
    let mut total = 0
    for it in body.items {
        total += it.qty * round(it.price * 100)
    }
    if get(body, "coupon", "") == "HALF" {
        total = (total + 1) / 2
    }
    db.execute("INSERT INTO orders (customer, items, total) VALUES (?, ?, ?)", [body.customer.name.trim(), len(body.items), total])
    return http.response(201, { id: db.last_insert_rowid(), items: len(body.items), total_cents: total })
}

@get("/orders/:id")
fn show(id: String) {
    if !regex.test(id, "^[0-9]+$") {
        return http.response(404, { error: "no such order" })
    }
    let rows = db.query("SELECT id, customer, items, total FROM orders WHERE id = ?", [int(id)])
    if len(rows) == 0 {
        return http.response(404, { error: "no such order" })
    }
    let r = rows[0]
    return { id: r.id, customer: r.customer, items: r.items, total_cents: r.total }
}
