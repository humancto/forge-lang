// Character-level text report: lengths, slices, padding, case and reversal
// all count Unicode code points, not bytes.

let mut all_words = []
let mut n = 0
for line in fs.lines("/dev/stdin") {
    if line.trim() == "" {
        continue
    }
    n += 1
    let words = filter(regex.split(line.trim(), "\\s+"), fn(w) { return w != "" })
    for w in words {
        all_words.push(w)
    }
    let cut = substring(line, 0, min(12, len(line)))
    println("{n}: chars={len(line)} words={len(words)} first3={substring(line, 0, min(3, len(line)))} padded=[{pad_end(cut, 12, ".")}]")
    println("   upper={line.upper()}")
    println("   reversed={reverse(line)}")
}
let distinct = sort(unique(map(all_words, fn(w) { return w.lower() })))
let mut longest = ""
for w in all_words {
    if len(w) > len(longest) {
        longest = w
    }
}
println("words: {len(all_words)} distinct: {len(distinct)}")
println("longest: {longest} ({len(longest)} chars)")
println("sorted: {join(distinct, " ")}")
