// Line diff by longest common subsequence (a 700 x 700 table in the large
// case): changes on stdout, a summary on stderr, exit status 1 when the
// texts differ.

let lines = fs.lines("/dev/stdin")
let sep = index_of(lines, "=====")
let a = slice(lines, 0, sep)
let b = slice(lines, sep + 1, len(lines))
let n = len(a)
let m = len(b)

// dp[i][j]: length of the longest common subsequence of a[i..] and b[j..].
let mut dp = []
for i in range(0, n + 1) {
    dp.push(map(range(0, m + 1), fn(j) { return 0 }))
}
let mut i = n - 1
while i >= 0 {
    let mut j = m - 1
    while j >= 0 {
        if a[i] == b[j] {
            dp[i][j] = dp[i + 1][j + 1] + 1
        } else {
            dp[i][j] = max(dp[i + 1][j], dp[i][j + 1])
        }
        j -= 1
    }
    i -= 1
}

let mut x = 0
let mut y = 0
let mut deleted = 0
let mut inserted = 0
while x < n || y < m {
    if x < n && y < m && a[x] == b[y] {
        x += 1
        y += 1
    } else if y >= m || (x < n && dp[x + 1][y] >= dp[x][y + 1]) {
        println("-{x + 1}: {a[x]}")
        deleted += 1
        x += 1
    } else {
        println("+{y + 1}: {b[y]}")
        inserted += 1
        y += 1
    }
}
if deleted > 0 || inserted > 0 {
    eprintln("{deleted} deleted, {inserted} inserted, {dp[0][0]} unchanged")
    exit(1)
}
eprintln("no differences ({n} lines)")
