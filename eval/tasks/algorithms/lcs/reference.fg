fn lcs(a: String, b: String) -> String {
    let xs = a.chars()
    let ys = b.chars()
    let n = len(xs)
    let m = len(ys)
    let mut dp = []
    for i in range(0, n + 1) {
        let mut row = []
        for j in range(0, m + 1) {
            row = push(row, 0)
        }
        dp = push(dp, row)
    }
    for i in range(1, n + 1) {
        for j in range(1, m + 1) {
            if xs[i - 1] == ys[j - 1] {
                dp[i][j] = dp[i - 1][j - 1] + 1
            } else {
                dp[i][j] = math.max(dp[i - 1][j], dp[i][j - 1])
            }
        }
    }
    let mut i = n
    let mut j = m
    let mut out = []
    while i > 0 && j > 0 {
        if xs[i - 1] == ys[j - 1] {
            out = push(out, xs[i - 1])
            i -= 1
            j -= 1
        } else if dp[i - 1][j] >= dp[i][j - 1] {
            i -= 1
        } else {
            j -= 1
        }
    }
    let s = join(reverse(out), "")
    let shown = if s == "" { "-" } else { s }
    return "{dp[n][m]} {shown}"
}

for line in split(input(), "\n") {
    let p = line.words()
    if len(p) == 2 {
        println("{p[0]} {p[1]}: {lcs(p[0], p[1])}")
    }
}
