let dims = input().words()
let rows = int(dims[0])
let cols = int(dims[1])
let mut cells = []
let mut top = 0
let mut bottom = rows - 1
let mut left = 0
let mut right = cols - 1
while top <= bottom && left <= right {
    for j in range(left, right + 1) {
        cells = push(cells, [top, j])
    }
    for i in range(top + 1, bottom + 1) {
        cells = push(cells, [i, right])
    }
    if top < bottom {
        let mut j = right - 1
        while j >= left {
            cells = push(cells, [bottom, j])
            j -= 1
        }
    }
    if left < right {
        let mut i = bottom - 1
        while i > top {
            cells = push(cells, [i, left])
            i -= 1
        }
    }
    top += 1
    bottom -= 1
    left += 1
    right -= 1
}
println(join(map(cells, fn(p) { return str(p[0] * cols + p[1] + 1) }), " "))
let mut grid = []
for i in range(0, rows) {
    let mut row = []
    for j in range(0, cols) {
        row = push(row, 0)
    }
    grid = push(grid, row)
}
for k in range(0, len(cells)) {
    let p = cells[k]
    grid[p[0]][p[1]] = k + 1
}
let width = len(str(rows * cols))
for row in grid {
    println(join(map(row, fn(v) { return pad_start(str(v), width, " ") }), " "))
}
