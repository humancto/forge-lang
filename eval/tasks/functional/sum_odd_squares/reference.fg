let xs = map(input().words(), fn(w) { return int(w) })
let odd = filter(xs, fn(x) { return x % 2 != 0 })
let odd_squares = reduce(map(odd, fn(x) { return x * x }), 0, fn(acc, x) { return acc + x })
let evens = map(filter(xs, fn(x) { return x % 2 == 0 }), fn(x) { return str(x * 2) })
let product = reduce(filter(xs, fn(x) { return x > 0 }), 1, fn(acc, x) { return acc * x })
println("odd squares sum: {odd_squares}")
println("evens doubled: " + join(evens, " "))
println("product of positives: {product}")
println("all below 100: {all(xs, fn(x) { return x < 100 })}")
println("any negative: {any(xs, fn(x) { return x < 0 })}")
