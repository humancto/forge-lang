let lines = split(input(), "\n")
let base = lines[0].trim()
let mut ok = 0
let mut failed = 0
for line in slice(lines, 1, len(lines)) {
    let path = line.trim()
    if path == "" {
        continue
    }
    let resp = http.get(base + path)
    let status = resp.status
    let mut class = "server error"
    if status >= 200 && status < 300 {
        class = "ok"
        ok += 1
    } else if status >= 400 && status < 500 {
        class = "client error"
        failed += 1
    } else {
        failed += 1
    }
    println("{path}: {status} {class}")
}
println("ok: {ok}, failed: {failed}")
