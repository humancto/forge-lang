let mut cfg = json.parse(fs.read("config.json"))
let old = cfg.version
let parts = split(old, ".")
let new_version = "{parts[0]}.{parts[1]}.{int(parts[2]) + 1}"
cfg.version = new_version
if !contains(cfg.features, "beta") {
    cfg.features = push(cfg.features, "beta")
}
cfg.updated_by = "eval"
cfg = omit(cfg, ["deprecated"])
// json.parse keeps the file's key order: sort every object's keys.
fn sorted_keys(v) {
    if typeof(v) == "Object" {
        let mut out = {}
        for key in sort(keys(v)) {
            out[key] = sorted_keys(v[key])
        }
        return out
    }
    if typeof(v) == "Array" {
        return map(v, fn(x) { return sorted_keys(x) })
    }
    return v
}
fs.write("config.json", json.pretty(sorted_keys(cfg)) + "\n")
println("version: {old} -> {new_version}")
println("features: {len(cfg.features)}")
