// channel_closed_test.fg — `is_closed(ch)` and how `select` reports a
// finished channel (V3 finding 20). A channel is finished once it is closed
// and every value sent before `close` was received: `is_closed` is true
// exactly then, and `select` returns `null` at once when all its channels
// are finished (also `null` on timeout; `all(chs, is_closed)` tells them
// apart).

@test
fn test_is_closed_waits_for_the_buffer() {
    let ch = channel()
    assert_eq(is_closed(ch), false)
    send(ch, 1)
    send(ch, 2)
    close(ch)
    assert_eq(is_closed(ch), false)
    assert_eq(is_closed(ch), false)
    assert_eq(receive(ch), 1)
    assert_eq(try_receive(ch), Some(2))
    assert_eq(is_closed(ch), true)
    assert_eq(receive(ch), null)
}

@test
fn test_is_closed_keeps_order_for_select() {
    let ch = channel()
    send(ch, "a")
    send(ch, "b")
    close(ch)
    assert_eq(is_closed(ch), false)
    assert_eq(select([ch], 100), [0, "a"])
    assert_eq(select([ch], 100), [0, "b"])
    assert_eq(is_closed(ch), true)
}

@test
fn test_select_returns_at_once_when_every_channel_is_finished() {
    let a = channel()
    let b = channel()
    send(a, 1)
    close(a)
    close(b)
    assert_eq(select([a, b], 5000), [0, 1])
    let t0 = time.now().unix_ms
    assert_eq(select([a, b], 5000), null)
    assert_eq(select([a, b]), null)
    assert(time.now().unix_ms - t0 < 2000)
    assert(all([a, b], fn(c) { return is_closed(c) }))
    assert_eq(select([]), null)
}

@test
fn test_select_timeout_is_not_closed() {
    let a = channel()
    assert_eq(select([a], 10), null)
    assert_eq(is_closed(a), false)
}

@test
fn test_merge_until_every_producer_finished() {
    let a = channel()
    let b = channel()
    spawn {
        for i in range(0, 3) {
            send(a, i)
        }
        close(a)
    }
    spawn {
        send(b, 10)
        close(b)
    }
    let chs = [a, b]
    let mut total = 0
    let mut n = 0
    while true {
        let r = select(chs, 1000)
        if r == null {
            if all(chs, fn(c) { return is_closed(c) }) {
                break
            }
            continue
        }
        total += r[1]
        n += 1
    }
    assert_eq(n, 4)
    assert_eq(total, 13)
}

@test
fn test_channel_argument_errors() {
    assert_throws(fn() { return is_closed(5) })
    try {
        is_closed([1])
    } catch e {
        assert_eq(e.code, "E0015")
        assert(e.message.starts_with("is_closed() requires a channel"))
    }
    try {
        select([1], 10)
    } catch e {
        assert(e.message.starts_with("select() requires an array of channels"))
    }
}
