// expect: { "E0015": 219, "ok": 69, "E0038": 2, "E0004": 10 }
// Builtin argument errors are identical on both engines (V3 finding 12):
// the same calls fail or succeed, with the same code, type and message
// (texts from `semantics::builtin_args`, annotated with the argument
// types). engine_diff compares this output between the VM and the
// interpreter; the value is how many calls ended how. Generated table:
// each builtin with arguments of the wrong kinds.
let mut tally = {}
fn show(label: String, f) {
    let mut outcome = "ok"
    try {
        println("{label}: ok {f()}")
    } catch e {
        outcome = e.code
        println("{label}: {e.code} {e.type} {e.message}")
    }
    tally[outcome] = get(tally, outcome, 0) + 1
    return null
}
