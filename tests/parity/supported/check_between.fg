// expect: ok
// `check x between lo and hi`: the bounds are parsed below the logical
// operators, so `and` / `&&` separate them; ints and floats may be mixed.
let x = 5
let lo = 1
let hi = 10
check x between 1 and 10
check x between 1 && 10
check x between lo and hi
check x between 1.0 and 10.0
check 2.5 between 1 and 10
check x between 0 - 1 and 2 * 5
say "all passed"
for v in [0, 11] {
    try {
        check v between 1 && 10
        say "bad {v}"
    } catch e {
        say "caught {v}"
    }
}
"ok"
