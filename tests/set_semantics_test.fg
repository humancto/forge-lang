// set_semantics_test.fg — sets keep insertion order and their equality
// rules (Int/Float promotion, NaN equals NaN, structural equality of
// nested values) while add/has/remove use a hash index. Both engines.

fn items_of(s) {
    let mut out = []
    for x in s { out.push(x) }
    return out
}

@test
define test_duplicates_keep_the_first_occurrence_in_order() {
    let s = set([3, 1, 3, 2, 1, 3])
    assert_eq(items_of(s), [3, 1, 2])
    assert_eq(len(s), 3)
    let mut t = set([])
    for x in ["b", "a", "b", "c", "a"] { t.add(x) }
    assert_eq(t.to_array(), ["b", "a", "c"])
}

@test
define test_ints_and_floats_that_compare_equal_are_one_member() {
    let s = set([1, 1.0, 2.0, 2, 0, -0.0])
    assert_eq(len(s), 3)
    assert_eq(str(s.to_array()[0]), "1")
    assert(s.has(2))
    assert(s.has(1.0))
    assert(s.has(0.0))
    assert(!s.has(1.5))
    let mut m = set([1])
    m.add(1.0)
    assert_eq(len(m), 1)
    m.remove(1.0)
    assert_eq(len(m), 0)
}

@test
define test_nan_is_one_member() {
    let nan = math.sqrt(-1.0)
    let mut s = set([nan, 1])
    s.add(nan)
    assert_eq(len(s), 2)
    assert(s.has(nan))
    s.remove(nan)
    assert_eq(s.to_array(), [1])
}

@test
define test_nested_values_compare_structurally() {
    let mut s = set([])
    s.add([1, 2])
    s.add([1.0, 2])
    s.add({a: 1, b: "x"})
    s.add({b: "x", a: 1.0})
    s.add(set([1, 2]))
    s.add(set([2, 1]))
    s.add(Some(1))
    s.add(Some(1.0))
    assert_eq(len(s), 4)
    assert(s.has([1, 2.0]))
    assert(s.has({a: 1, b: "x"}))
    assert(!s.has([2, 1]))
    assert(!s.has({a: 1}))
}

@test
define test_removal_keeps_order_and_readding_appends() {
    let mut s = set([])
    for i in range(30) { s.add(i) }
    for i in range(30) {
        if i % 3 != 0 { s.remove(i) }
    }
    assert_eq(items_of(s), [0, 3, 6, 9, 12, 15, 18, 21, 24, 27])
    s.remove(100)
    assert_eq(len(s), 10)
    s.add(1)
    s.add(0)
    assert_eq(items_of(s), [0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 1])
    assert(s.has(27))
    assert(!s.has(26))
}

@test
define test_updates_do_not_leak_into_copies() {
    let mut s = set([1, 2])
    let before = s
    s.add(3)
    s.remove(1)
    let holder = [s]
    s.add(4)
    assert_eq(before.to_array(), [1, 2])
    assert_eq(holder[0].to_array(), [2, 3])
    assert_eq(s.to_array(), [2, 3, 4])
    // `add` on a mutable variable updates it and returns the new set.
    let added = s.add(5)
    assert_eq(added.to_array(), [2, 3, 4, 5])
    assert_eq(len(s), 4)
}

@test
define test_set_operations_keep_order() {
    let a = set([4, 1, 3, 2])
    let b = set([3.0, 5, 4])
    assert_eq(a.union(b).to_array(), [4, 1, 3, 2, 5])
    assert_eq(a.intersect(b).to_array(), [4, 3])
    assert_eq(a.diff(b).to_array(), [1, 2])
    assert(a == set([1, 2, 3, 4.0]))
    assert(a != b)
    assert(contains(a, 3.0))
}

@test
define test_many_members() {
    let mut s = set([])
    for i in range(2000) { s.add(i % 1000) }
    assert_eq(len(s), 1000)
    let mut hits = 0
    for i in range(2000) {
        if s.has(i) { hits = hits + 1 }
    }
    assert_eq(hits, 1000)
    for i in range(1000) {
        if i % 2 == 1 { s.remove(i) }
    }
    assert_eq(len(s), 500)
    let mut total = 0
    for x in s { total = total + x }
    assert_eq(total, 249500)
    assert_eq(s.to_array()[1], 2)
}
