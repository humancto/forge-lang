// Control flow and error handling in edition 2026 natural syntax.
let n = 3
if n > 5 {
    say "big"
} otherwise if n > 2 {
    say "medium"
} nah {
    say "small"
}

repeat n times {
    say "tick"
}
repeat 2 {
    say "tock"
}

let label = when n {
    < 2 -> "low",
    otherwise -> "high"
}
say label

safe {
    let boom = 1 / 0
}

fn parse(s) {
    if s == "" { return Err("empty") }
    return Ok(int(s))
}
let v = must parse("41") + 1
say v

check v > 0
check label is not empty
check v between 1 and 100

unpack {a, b} from { a: 1, b: 2 }
unpack [first, ...rest] from [1, 2, 3]
say a + b + first + len(rest)

fn numbers() {
    emit 1
}
