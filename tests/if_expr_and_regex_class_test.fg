// `if` expressions chain with `else if`, and `\p{..}` in a string is a
// regex Unicode class, not an interpolation (both engines, all editions).

fn bracket_for(c) {
    return if c == ")" { "(" } else if c == "]" { "[" } else { "{" }
}

@test
fn if_expression_with_else_if_chains() {
    assert_eq(bracket_for(")"), "(")
    assert_eq(bracket_for("]"), "[")
    assert_eq(bracket_for("}"), "{")
    let n = 50
    let size = if n < 3 { "small" } else if n < 10 { "medium" } else if n < 100 { "large" } else { "huge" }
    assert_eq(size, "large")
}

@test
fn if_expression_without_final_else_is_null() {
    let v = if false { 1 } else if false { 2 }
    assert_eq(v, null)
}

@test
fn unicode_classes_are_not_interpolated() {
    let L = "not used"
    assert_eq(regex.replace("Zoë, 42!", "[^\\p{L}\\p{N}]", ""), "Zoë42")
    assert_eq(regex.find_all("ab12", "\\P{L}+"), ["12"])
    assert_eq("{L}", "not used")
}
