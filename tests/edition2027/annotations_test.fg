// Edition 2027: annotations are enforced (docs/editions/2027.md).
// Statically certain contradictions of declared types stop the program
// before it runs (pinned by the CLI and type-checker tests); values the
// checker cannot see (JSON, unannotated helpers) are checked at annotated
// function boundaries while the program runs.
//   forge --edition 2027 test tests/edition2027 --engine both

struct Point { x: Int, y: Int }

fn first_int(xs: [Int]) -> Int { return xs[0] }
fn claims_int(v) -> Int { return v }
fn tail_claims_string(v) -> String { v }
fn norm(p: Point) -> Int { return p.x + p.y }
fn maybe_len(s: ?String) -> Int {
    if s == null { return 0 }
    return len(s)
}
fn scale(x: Float) -> Float { return x * 2.0 }
fn pair<T>(a: T, b: T) -> [T] { return [a, b] }
fn first<T>(xs: [T]) -> T { return xs[0] }

// Unannotated: the checker knows nothing about what this returns.
fn opaque(v) { return v }

@test
fn correct_calls_pass() {
    assert_eq(first_int([4, 5]), 4)
    assert_eq(norm(Point { x: 1, y: 2 }), 3)
    assert_eq(maybe_len(null), 0)
    assert_eq(maybe_len("abc"), 3)
    // An Int fits Float.
    assert_eq(scale(2), 4.0)
    assert_eq(first([7, 8]), 7)
    assert_eq(pair(1, 2.5), [1, 2.5])
}

@test
fn arguments_are_checked_at_run_time() {
    let data = json.parse("[\"a\", \"b\"]")
    assert_throws(fn() { first_int(data) })
    assert_throws(fn() { norm(opaque({ x: 1, y: 2 })) })
    assert_throws(fn() { maybe_len(opaque(5)) })
}

@test
fn returns_are_checked_at_run_time() {
    assert_eq(claims_int(3), 3)
    assert_throws(fn() { claims_int("three") })
    assert_eq(tail_claims_string("s"), "s")
    assert_throws(fn() { tail_claims_string(1) })
}

@test
fn violation_names_the_boundary() {
    let mut message = ""
    let mut code = ""
    try {
        first_int(opaque(["a"]))
    } catch e {
        message = e.message
        code = e.code
    }
    assert(contains(message, "argument 'xs' of 'first_int' must be [Int]"))
    assert_eq(code, "E0017")
}

@test
fn generic_parameters_are_consistent_within_a_call() {
    assert_eq(pair("a", "b"), ["a", "b"])
    assert_throws(fn() { pair(1, opaque("x")) })
}

@test
fn unannotated_code_is_unchecked() {
    assert_eq(opaque("anything"), "anything")
    let f = fn(x) { return x }
    assert_eq(f(1), 1)
    assert_eq(f("s"), "s")
}

struct OptUser { name: String }

fn find_opt_user(xs: [OptUser], n: String) -> ?OptUser {
    for u in xs {
        if u.name == n {
            return Some(u)
        }
    }
    return None
}

@test
fn option_of_struct_returns_pass_the_boundary_check() {
    let xs = [OptUser { name: "a" }]
    assert(is_some(find_opt_user(xs, "a")))
    assert(is_none(find_opt_user(xs, "b")))
}

fn checked_transfer(balances, amount: Int) -> Result<Object, String> {
    if amount <= 0 {
        return Err("amount must be positive")
    }
    let mut updated = balances
    updated["a"] = amount
    return Ok(updated)
}

@test
fn result_returns_keep_their_value_through_the_boundary_check() {
    let ok = checked_transfer({ a: 1 }, 5)
    assert(is_ok(ok))
    assert_eq(unwrap(ok).a, 5)
    let failed = match checked_transfer({ a: 1 }, 0) {
        Ok(_) => "ok",
        Err(message) => message,
    }
    assert_eq(failed, "amount must be positive")
}

// A declared Float makes an Int a Float (V2 finding 5: `half(3)` was 1).
fn half(x: Float) -> Float { return x / 2 }
fn int_result_as_float(n) -> Float { return n }
struct Price { amount: Float, discount: Float = 0 }
type Num = Int | Float
fn keep_num(n: Num) -> Num { return n }
fn floats(xs: [Float], o: ?Float) -> [Float] {
    if o == null { return xs }
    return xs + [o]
}

@test
fn float_annotations_widen_ints() {
    assert_eq(half(3), 1.5)
    assert_eq(typeof(half(3)), "Float")
    assert_eq(typeof(int_result_as_float(opaque(2))), "Float")
    let y: Float = 7
    assert_eq(y / 2, 3.5)
    let p = Price { amount: 5 }
    assert_eq(p.amount / 2, 2.5)
    assert_eq(typeof(p.discount), "Float")
    let lam = fn(v: Float) { return v / 4 }
    assert_eq(lam(2), 0.5)
    // An Int that a union member accepts stays an Int.
    assert_eq(typeof(keep_num(3)), "Int")
    let fs = floats([1, 2], 3)
    assert_eq(map(fs, fn(v) { return typeof(v) }), ["Float", "Float", "Float"])
    assert_eq(fs[0] / 2, 0.5)
}

fn apply_all(fs: [fn(Int) -> Int], x: Int) -> [Int] {
    return map(fs, fn(f) { return f(x) })
}
fn want_int(n: Int) -> Int { return n }

// V2 finding 4: arrays of functions failed the VM's run-time check.
@test
fn function_values_fit_function_annotations() {
    assert_eq(apply_all([fn(n) { return n + 1 }, fn(n) { return n * 2 }], 5), [6, 10])
    try {
        want_int(opaque(fn(n) { return n }))
        assert(false, "a function is not an Int")
    } catch e {
        assert_eq(e.message, "type error: argument 'n' of 'want_int' must be Int, got function")
    }
}
