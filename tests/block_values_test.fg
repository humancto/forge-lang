// Trailing block statements as values, nested place assignment, and
// arity checks on method calls. Runs on both engines (`--engine both`).

@test
define test_trailing_if_is_the_return_value() {
    fn sign(x) { if x < 0 { -1 } else if x == 0 { 0 } else { 1 } }
    assert_eq(sign(-5), -1)
    assert_eq(sign(0), 0)
    assert_eq(sign(9), 1)
    let pick = fn(c) { if c { "yes" } else { "no" } }
    assert_eq(pick(true), "yes")
    assert_eq(pick(false), "no")
}

@test
define test_trailing_if_without_else_is_null_when_not_taken() {
    fn maybe(c) { if c { 1 } }
    assert_eq(maybe(true), 1)
    assert_eq(maybe(false), null)
}

@test
define test_trailing_when_and_match_are_return_values() {
    fn size(n) { when n { < 10 -> "small", else -> "big" } }
    assert_eq(size(3), "small")
    assert_eq(size(30), "big")
    fn name(n) {
        match n {
            1 => "one"
            2 => {
                let s = "tw"
                s + "o"
            }
            _ => "many"
        }
    }
    assert_eq(name(1), "one")
    assert_eq(name(2), "two")
    assert_eq(name(7), "many")
}

@test
define test_trailing_if_keeps_side_effects_and_explicit_return() {
    let mut log = []
    fn work(c) {
        if c {
            log = push(log, "ran")
            return "early"
        }
    }
    assert_eq(work(true), "early")
    assert_eq(work(false), null)
    fn first_big(xs) {
        for x in xs {
            if x > 10 { return x }
        }
    }
    assert_eq(first_big([1, 20, 30]), 20)
    assert_eq(first_big([1, 2]), null)
}

@test
define test_nested_index_assignment_has_value_semantics() {
    let mut grid = [[1, 2], [3, 4]]
    let snapshot = grid
    grid[0][1] = 9
    grid[-1][0] = 30
    assert_eq(grid, [[1, 9], [30, 4]])
    assert_eq(snapshot, [[1, 2], [3, 4]])
}

@test
define test_nested_field_and_mixed_assignment() {
    let mut o = { a: { b: 1 }, list: [1, 2] }
    o.a.b = 5
    o.list[1] = 7
    o["a"]["b"] = 6
    assert_eq(o.a.b, 6)
    assert_eq(o.list, [1, 7])
    let mut rows = [{ n: 1 }, { n: 2 }]
    rows[1].n = 20
    assert_eq(rows[1].n, 20)
}

@test
define test_nested_assignment_out_of_bounds_fails() {
    let mut grid = [[1]]
    let mut caught = false
    try {
        grid[0][5] = 1
    } catch e {
        caught = true
    }
    assert(caught)
}

struct Counter { n: Int }
impl Counter {
    fn get(self) { self.n }
    fn add(self, k) { self.n + k }
}

@test
define test_method_calls_check_arity() {
    let c = Counter { n: 2 }
    assert_eq(c.get(), 2)
    assert_eq(c.add(3), 5)
    let mut msg = ""
    try {
        c.add()
    } catch e {
        msg = e.message
    }
    assert_eq(msg, "method add expects 1 argument, got 0")
    msg = ""
    try {
        c.get(1)
    } catch e {
        msg = e.message
    }
    assert_eq(msg, "method get expects 0 arguments, got 1")
}

@test
define test_object_field_functions_check_arity() {
    let api = { greet: fn(name) { "hi {name}" } }
    assert_eq(api.greet("bo"), "hi bo")
    let mut msg = ""
    try {
        api.greet()
    } catch e {
        msg = e.message
    }
    assert_eq(msg, "fn greet expects 1 argument, got 0")
}
