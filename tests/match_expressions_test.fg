// `match` as an expression, guards and or-patterns (RFC 0008 section 3).
// Runs on both engines (`forge test --engine both`).

type Shape = Circle(Float) | Rect(Float, Float) | Square(Float, Float) | Dot

type Color = Red | Green | Blue

fn size(n) {
    return match n {
        0 => "none",
        1 | 2 => "few",
        x if x < 10 => "some {x}",
        _ => "many",
    }
}

fn describe(s) {
    return match s {
        Circle(r) if r > 10.0 => "big circle",
        Circle(r) => "circle {r}",
        Rect(w, h) | Square(w, h) => "box {w}x{h}",
        Dot => "dot",
    }
}

@test
fn test_literal_binding_and_wildcard_arms() {
    assert_eq(size(0), "none")
    assert_eq(size(1), "few")
    assert_eq(size(2), "few")
    assert_eq(size(7), "some 7")
    assert_eq(size(42), "many")
}

@test
fn test_match_in_let_initializer() {
    let word = "go"
    let action = match word {
        "stop" => 0,
        "go" => 1,
        _ => -1,
    }
    assert_eq(action, 1)
    let neg = match -3 {
        -3 => "minus three",
        _ => "other",
    }
    assert_eq(neg, "minus three")
}

@test
fn test_constructor_patterns_guards_and_or_patterns() {
    assert_eq(describe(Circle(20.0)), "big circle")
    assert_eq(describe(Circle(2.0)), "circle 2")
    assert_eq(describe(Rect(2.0, 3.0)), "box 2x3")
    assert_eq(describe(Square(4.0, 4.0)), "box 4x4")
    assert_eq(describe(Dot), "dot")
}

@test
fn test_guard_falls_through_to_later_arms() {
    let classify = fn(n) {
        match n {
            x if x < 0 => "negative",
            x if x % 2 == 0 => "even",
            _ => "odd",
        }
    }
    assert_eq(classify(-4), "negative")
    assert_eq(classify(8), "even")
    assert_eq(classify(9), "odd")
}

@test
fn test_guard_sees_bindings_and_outer_variables() {
    let cap = 100
    let r = match Some(150) {
        Some(v) if v > cap => "over by {v - cap}",
        Some(v) => "ok {v}",
        None => "nothing",
    }
    assert_eq(r, "over by 50")
}

@test
fn test_or_patterns_of_literals_and_variants() {
    let weekday = fn(d) {
        match d {
            "sat" | "sun" => "weekend",
            _ => "weekday",
        }
    }
    assert_eq(weekday("sun"), "weekend")
    assert_eq(weekday("mon"), "weekday")
    let warm = fn(c) {
        match c {
            Red | Green => true,
            Blue => false,
        }
    }
    assert(warm(Red))
    assert(warm(Green))
    assert(!warm(Blue))
}

@test
fn test_nested_patterns() {
    let inner = fn(r) {
        match r {
            Ok(Some(1 | 2)) => "small",
            Ok(Some(n)) => "value {n}",
            Ok(None) => "empty",
            Err(e) => "error {e}",
        }
    }
    assert_eq(inner(Ok(Some(2))), "small")
    assert_eq(inner(Ok(Some(9))), "value 9")
    assert_eq(inner(Ok(None)), "empty")
    assert_eq(inner(Err("bad")), "error bad")
}

@test
fn test_nested_match_expressions() {
    let grid = fn(x, y) {
        match x {
            0 => match y {
                0 => "origin",
                _ => "y-axis",
            },
            _ => match y {
                0 => "x-axis",
                _ => "plane",
            },
        }
    }
    assert_eq(grid(0, 0), "origin")
    assert_eq(grid(0, 5), "y-axis")
    assert_eq(grid(3, 0), "x-axis")
    assert_eq(grid(3, 4), "plane")
}

@test
fn test_match_in_lambdas_and_call_arguments() {
    let labels = map([1, 5, 50], fn(n) { size(n) })
    assert_eq(labels, ["few", "some 5", "many"])
    let parity = map([1, 2, 3], fn(n) {
        match n % 2 {
            0 => "even",
            _ => "odd",
        }
    })
    assert_eq(parity, ["odd", "even", "odd"])
    assert_eq(len(match 3 { 3 => "abc", _ => "" }), 3)
}

@test
fn test_block_arms_produce_their_trailing_value() {
    let n = 4
    let result = match n {
        0 => "zero",
        x if x > 0 => {
            let doubled = x * 2
            "double is {doubled}"
        },
        _ => {
            "negative"
        },
    }
    assert_eq(result, "double is 8")
}

@test
fn test_match_in_string_interpolation() {
    let n = 2
    let label = match n { 1 => "one", 2 => "two", _ => "many" }
    assert_eq("got {label}", "got two")
    assert_eq("count: {size(n)}", "count: few")
}

@test
fn test_match_expression_with_return_in_arm() {
    let first_positive = fn(xs) {
        for x in xs {
            let kind = match x {
                v if v > 0 => {
                    return v
                },
                _ => "skip",
            }
            assert_eq(kind, "skip")
        }
        return null
    }
    assert_eq(first_positive([-1, 0, 7, 9]), 7)
}

@test
fn test_statement_match_with_guard_still_works() {
    let mut log = []
    for n in [1, 15, 3] {
        match n {
            x if x > 10 => {
                log = push(log, "big")
            }
            _ => {
                log = push(log, "small")
            }
        }
    }
    assert_eq(log, ["small", "big", "small"])
}

@test
fn test_closure_created_in_guard() {
    let xs = [3, 4]
    let r = match 4 {
        v if any(xs, fn(y) { y == v }) => "listed {v}",
        _ => "not listed",
    }
    assert_eq(r, "listed 4")
    let s = match 5 {
        v if any(xs, fn(y) { y == v }) => "listed {v}",
        v => "not listed {v}",
    }
    assert_eq(s, "not listed 5")
}

@test
fn test_no_matching_arm_is_an_error() {
    assert_throws(fn() {
        let x = match 5 {
            1 => "one",
            n if n > 10 => "big",
        }
    })
    assert_throws(fn() {
        let y = match Circle(1.0) {
            Circle(r) if r > 5.0 => "big",
            Rect(w, h) | Square(w, h) => "box",
            Dot => "dot",
        }
    })
}
