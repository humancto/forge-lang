// map_semantics_test.fg — maps keep insertion order and their key
// equality rules (Int/Float promotion, NaN equals NaN, structural equality
// of nested keys) while get/set/has/remove use a hash index, and
// `m = m.set(k, v)` updating a variable in place never changes another
// binding. Both engines.

fn keys_of(m) {
    let mut out = []
    for k, v in m { out.push(k) }
    return out
}

@test
define test_set_overwrites_in_place_and_appends_new_keys() {
    let mut m = map([("b", 1), ("a", 2), ("b", 3)])
    assert_eq(keys_of(m), ["b", "a"])
    assert_eq(m.get("b"), 3)
    m = m.set("c", 4)
    m = m.set("b", 5)
    assert_eq(keys_of(m), ["b", "a", "c"])
    assert_eq(m.values(), [5, 2, 4])
    assert_eq(m.len(), 3)
}

@test
define test_ints_and_floats_that_compare_equal_are_one_key() {
    let mut m = map()
    m = m.set(1, "int")
    m = m.set(1.0, "float")
    m = m.set(0, "zero")
    m = m.set(-0.0, "negative zero")
    assert_eq(m.len(), 2)
    assert_eq(str(m.keys()[0]), "1")
    assert_eq(m.get(1), "float")
    assert_eq(m.get(0.0), "negative zero")
    assert(m.has(1.0))
    assert(!m.has(1.5))
    m = m.remove(1.0)
    assert_eq(m.len(), 1)
}

@test
define test_nan_is_one_key() {
    let nan = math.sqrt(-1.0)
    let mut m = map()
    m = m.set(nan, 1)
    m = m.set(nan, 2)
    assert_eq(m.len(), 1)
    assert_eq(m.get(nan), 2)
    m = m.remove(nan)
    assert_eq(m.len(), 0)
}

@test
define test_nested_keys_compare_by_content() {
    let mut m = map()
    m = m.set([1, 2], "list")
    m = m.set({a: 1, b: [2]}, "object")
    m = m.set((1, "x"), "tuple")
    m = m.set(set([1, 2]), "set")
    assert_eq(m.get([1.0, 2]), "list")
    assert_eq(m.get({b: [2.0], a: 1}), "object")
    assert_eq(m.get((1, "x")), "tuple")
    assert_eq(m.get(set([2, 1])), "set")
    assert(!m.has([2, 1]))
    assert(contains(m, [1, 2]))
}

@test
define test_removal_then_reinsert_moves_the_key_to_the_end() {
    let mut m = map()
    for i in range(0, 50) { m = m.set(i, i) }
    for i in range(0, 50) {
        if i % 5 != 0 { m = m.remove(i) }
    }
    m = m.set(3, "back")
    m = m.set(0, "same place")
    assert_eq(keys_of(m), [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 3])
    assert_eq(m.get(0), "same place")
    assert_eq(m.to_array()[10], (3, "back"))
    assert_eq(m.len(), 11)
}

@test
define test_updating_a_variable_never_changes_an_alias() {
    let mut m = map([("x", 1)])
    let a = m
    m = m.set("y", 2)
    let b = m
    m = m.remove("x")
    let c = m.set("z", 3)
    m = m.set("y", 20)
    assert_eq(a, map([("x", 1)]))
    assert_eq(b, map([("x", 1), ("y", 2)]))
    assert_eq(c, map([("y", 2), ("z", 3)]))
    assert_eq(m, map([("y", 20)]))
}

@test
define test_word_count_with_get_and_set() {
    let mut counts = map()
    for w in ["to", "be", "or", "not", "to", "be"] {
        if counts.has(w) {
            counts = counts.set(w, counts.get(w) + 1)
        } else {
            counts = counts.set(w, 1)
        }
    }
    assert_eq(counts.to_array(), [("to", 2), ("be", 2), ("or", 1), ("not", 1)])
    assert_eq(json.parse(json.stringify(counts)), {to: 2, be: 2, or: 1, not: 1})
}

@test
define test_large_map_lookups() {
    let mut m = map()
    for i in range(0, 5000) { m = m.set("k{i}", i) }
    let mut total = 0
    for i in range(0, 5000) { total = total + m.get("k{i}") }
    assert_eq(total, 12497500)
    assert_eq(m.len(), 5000)
    assert(m == map(m.to_array()))
}

@test
define test_frozen_maps_reject_set() {
    let mut f = freeze(map([(1, 2)]))
    let mut message = ""
    try { f = f.set(1, 3) } catch e { message = e.message }
    assert_eq(message, "cannot mutate a frozen map")
    assert_eq(f.get(1), 2)
}
