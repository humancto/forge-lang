// Interpreter benchmark: build a 100k-entry Map with `m = m.set(k, v)`
// (computed String keys), then look every key up with `m.get` / `m.has`.
// Same program as benchmarks/vm/map_build.fg.
let n = 100000
let mut m = map()
let mut i = 0
while i < n {
    m = m.set("k" + str(i), i)
    i = i + 1
}
let mut total = 0
let mut j = 0
while j < n {
    let k = "k" + str(j)
    if m.has(k) { total = total + m.get(k) }
    j = j + 1
}
println(m.len())
println(total)
