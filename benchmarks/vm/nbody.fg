// VM benchmark: the classic 5-body (Sun + Jovian planets) simulation,
// 20000 steps. Float arithmetic over small arrays.
fn energy(x, y, z, vx, vy, vz, m) {
    let n = len(m)
    let mut e = 0.0
    for i in range(n) {
        e = e + 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
        for j in range(i + 1, n) {
            let dx = x[i] - x[j]
            let dy = y[i] - y[j]
            let dz = z[i] - z[j]
            e = e - m[i] * m[j] / math.sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    return e
}

fn simulate(steps) {
    let solar_mass = 4.0 * math.pi * math.pi
    let dpy = 365.24
    let mut x = [0.0, 4.8414314424647209023078176, 8.3433667182445798715662022, 12.8943695621391309913406076, 15.3796971148509165061568638]
    let mut y = [0.0, -1.1603200440274283877784001, 4.1247985641243047894022311, -15.1111514016986312469725817, -25.9193146099879641042207368]
    let mut z = [0.0, -0.1036220444711231092327353, -0.4035234171143213810495354, -0.2233075788926557336822043, 0.1792587729503711813094924]
    let mut vx = [0.0, 0.0016600766427440369430585 * dpy, -0.0027674251072686241112453 * dpy, 0.0029646013756476161798981 * dpy, 0.0026806777249038932220415 * dpy]
    let mut vy = [0.0, 0.0076990111841974042533598 * dpy, 0.0049985280123491723780482 * dpy, 0.0023784717395948094982583 * dpy, 0.0016282417003824229545517 * dpy]
    let mut vz = [0.0, -0.0000690460016972063023166 * dpy, 0.0000230417297573763928814 * dpy, -0.0000296589568540237555686 * dpy, -0.0000951592254519715869537 * dpy]
    let m = [solar_mass, 0.000954791938424326609193 * solar_mass, 0.0002858859806661308115838 * solar_mass, 0.0000436624404335156298144 * solar_mass, 0.0000515138902046611451332 * solar_mass]
    let n = len(m)

    // Offset the Sun's momentum.
    let mut px = 0.0
    let mut py = 0.0
    let mut pz = 0.0
    for i in range(n) {
        px = px + vx[i] * m[i]
        py = py + vy[i] * m[i]
        pz = pz + vz[i] * m[i]
    }
    vx[0] = -px / solar_mass
    vy[0] = -py / solar_mass
    vz[0] = -pz / solar_mass

    let before = energy(x, y, z, vx, vy, vz, m)
    let dt = 0.01
    repeat steps times {
        for i in range(n) {
            for j in range(i + 1, n) {
                let dx = x[i] - x[j]
                let dy = y[i] - y[j]
                let dz = z[i] - z[j]
                let d2 = dx * dx + dy * dy + dz * dz
                let mag = dt / (d2 * math.sqrt(d2))
                let mi = m[i] * mag
                let mj = m[j] * mag
                vx[i] = vx[i] - dx * mj
                vy[i] = vy[i] - dy * mj
                vz[i] = vz[i] - dz * mj
                vx[j] = vx[j] + dx * mi
                vy[j] = vy[j] + dy * mi
                vz[j] = vz[j] + dz * mi
            }
        }
        for i in range(n) {
            x[i] = x[i] + dt * vx[i]
            y[i] = y[i] + dt * vy[i]
            z[i] = z[i] + dt * vz[i]
        }
    }
    let after = energy(x, y, z, vx, vy, vz, m)
    return "{math.round(before * 1000000000)} {math.round(after * 1000000000)}"
}
println(simulate(20000))
