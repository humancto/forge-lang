// VM benchmark: sort 200k pseudo-random integers with a comparator lambda.
fn make(n) {
    let mut xs = []
    let mut seed = 7
    for i in range(n) {
        seed = (seed * 1103515 + 12345) % 2147483648
        xs.push(seed % 1000000)
    }
    return xs
}
let sorted = sort(make(200000), fn(a, b) { return a - b })
println(sorted[0])
println(sorted[100000])
println(sorted[199999])
